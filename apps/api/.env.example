# Peblo TV Mini backend environment variables

# PostgreSQL
DATABASE_URL=postgresql://peblo_user:peblo_password@localhost:5432/peblo_tv
DB_NAME=peblo_tv
DB_USER=peblo_user
DB_PASSWORD=peblo_password
DB_PORT=5432

# JWT (used when authentication is implemented)
JWT_SECRET=change-me-in-production

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/peblo_tv/storage
CATALOGUE_STORAGE_PATH=/tmp/peblo_tv/catalogue

# Alerts (used when alerts are implemented)
ALERT_WEBHOOK_URL=https://example.com/webhook
