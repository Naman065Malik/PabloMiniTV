# Environment variables for Peblo TV Mini backend

# PostgreSQL
DATABASE_URL=postgresql://peblo_user:peblo_password@localhost:5432/peblo_db

# JWT
JWT_SECRET=change-me-in-production

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/peblo_storage
CATALOGUE_STORAGE_PATH=/tmp/peblo_catalogue

# Alerts
ALERT_WEBHOOK_URL=https://example.com/webhook
